{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "day12",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "day12",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "build40for40.com/feel-good", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/feel-good/*", "zone_name": "build40for40.com" }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://build40for40.com/feel-good",
    "ALLOWED_ORIGIN": "https://build40for40.com",
    "POSTMARK_TRANSACTIONAL_STREAM": "outbound",
    "POSTMARK_BROADCAST_STREAM": "broadcast"
  },
  "workers_dev": true,
  "observability": { "enabled": true }
}
